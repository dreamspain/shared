{
  "name": "@dreamspain/tiehoy-route-contract",
  "version": "0.1.0",
  "description": "Dependency-free public route identity contract for TIEHoy.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./design-tokens.css": "./design-tokens/tokens.css",
    "./check-css": "./design-tokens/check-css.mjs"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "design-tokens",
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "tiehoy-check-css": "design-tokens/check-css.mjs"
  }
}
