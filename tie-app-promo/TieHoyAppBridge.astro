---
/**
 * TIE Hoy App Promo — Golden HTML: TIEHoy_App_Promo_Classic_v4_Articulated.html
 * Three planes: identity → capability → action.
 * CSS values copied verbatim from the Golden source. Do not translate.
 *
 * Destination: App Store (from tiehoy-ios-launch-offer.ts)
 * Tracking: IntersectionObserver view + click beacon
 */
import type { Lang } from "@/config/i18n";
import { TIEHOY_IOS_LAUNCH_OFFER } from "@/config/tiehoy-ios-launch-offer";

interface Props {
  lang: Lang;
  context: "consultar" | "province" | "office" | "hub";
}

const { lang, context } = Astro.props;
const appStoreUrl = TIEHOY_IOS_LAUNCH_OFFER.appStoreUrl;

type CopySet = { eyebrow: string; line1: string; line2: string; line3: string; cta: string };

const copyByContext: Record<string, Record<Lang, CopySet>> = {
  consultar: {
    es: { eyebrow: "La app", line1: "Consulta tu lote.", line2: "Sigue tu oficina.", line3: "Recibe el aviso cuando avance.", cta: "Abrir TIE Hoy" },
    en: { eyebrow: "The app", line1: "Check your lote.", line2: "Follow your office.", line3: "Get notified when it moves.", cta: "Open TIE Hoy" },
    fr: { eyebrow: "L'app", line1: "Consulte ton lot.", line2: "Suis ton bureau.", line3: "Reçois l'alerte quand ça avance.", cta: "Ouvrir TIE Hoy" },
    ru: { eyebrow: "Приложение", line1: "Проверь свой lote.", line2: "Следи за офисом.", line3: "Получи уведомление, когда продвинется.", cta: "Открыть TIE Hoy" },
    zh: { eyebrow: "App", line1: "查询你的 lote。", line2: "跟踪你的办事处。", line3: "进展时收到通知。", cta: "打开 TIE Hoy" },
  },
  province: {
    es: { eyebrow: "La app", line1: "Consulta tu lote.", line2: "Sigue tu oficina.", line3: "Recibe el aviso cuando avance.", cta: "Abrir TIE Hoy" },
    en: { eyebrow: "The app", line1: "Check your lote.", line2: "Follow your office.", line3: "Get notified when it moves.", cta: "Open TIE Hoy" },
    fr: { eyebrow: "L'app", line1: "Consulte ton lot.", line2: "Suis ton bureau.", line3: "Reçois l'alerte quand ça avance.", cta: "Ouvrir TIE Hoy" },
    ru: { eyebrow: "Приложение", line1: "Проверь свой lote.", line2: "Следи за офисом.", line3: "Получи уведомление, когда продвинется.", cta: "Открыть TIE Hoy" },
    zh: { eyebrow: "App", line1: "查询你的 lote。", line2: "跟踪你的办事处。", line3: "进展时收到通知。", cta: "打开 TIE Hoy" },
  },
  hub: {
    es: { eyebrow: "La app", line1: "Consulta tu lote.", line2: "Sigue tu oficina.", line3: "Recibe el aviso cuando avance.", cta: "Abrir TIE Hoy" },
    en: { eyebrow: "The app", line1: "Check your lote.", line2: "Follow your office.", line3: "Get notified when it moves.", cta: "Open TIE Hoy" },
    fr: { eyebrow: "L'app", line1: "Consulte ton lot.", line2: "Suis ton bureau.", line3: "Reçois l'alerte quand ça avance.", cta: "Ouvrir TIE Hoy" },
    ru: { eyebrow: "Приложение", line1: "Проверь свой lote.", line2: "Следи за офисом.", line3: "Получи уведомление, когда продвинется.", cta: "Открыть TIE Hoy" },
    zh: { eyebrow: "App", line1: "查询你的 lote。", line2: "跟踪你的办事处。", line3: "进展时收到通知。", cta: "打开 TIE Hoy" },
  },
};
copyByContext.office = copyByContext.province;

const contextCopy = copyByContext[context] ?? copyByContext.consultar;
const c = contextCopy[lang] ?? contextCopy.es;
const id = `tie-app-bridge-${context}`;
---

<aside id={id} class="tie-app-promo" data-context={context} aria-label="TIE Hoy app">
  <div class="tie-app-promo__brand">
    <span class="tie-app-promo__eyebrow">{c.eyebrow}</span>
    <div class="tie-app-promo__name-row">
      <img src="/orchid-logo.png" alt="" width="28" height="28" class="tie-app-promo__logo" />
      <h2 class="tie-app-promo__name">TIE <em>Hoy</em></h2>
    </div>
  </div>

  <p class="tie-app-promo__promise">
    <span>{c.line1}</span>
    <span>{c.line2}</span>
    <span>{c.line3}</span>
  </p>

  <a class="tie-app-promo__action" href={appStoreUrl} target="_blank" rel="noopener noreferrer" aria-label={c.cta}>
    <svg class="tie-app-promo__apple" viewBox="0 0 814 1000" aria-hidden="true"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57.8-155.5-127.4c-58.5-81.8-105.8-209.3-105.8-330.8 0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8.6 15.6 1.3 18.2 2.6.6 6.4 1.3 10.2 1.3 45.4 0 103.4-30.4 139.5-71.4z" fill="currentColor"/></svg>
    <span>{c.cta}</span>
    <span class="tie-app-promo__arrow" aria-hidden="true">→</span>
  </a>
</aside>

<script define:vars={{ id }}>
  (() => {
    const el = document.getElementById(id);
    if (!el) return;
    const payload = () => ({
      event: "",
      context: el.dataset.context || "",
      path: window.location.pathname,
    });
    const send = (event) => {
      try {
        const p = payload();
        p.event = event;
        navigator.sendBeacon("/api/tie/page-beacon/", new Blob([JSON.stringify(p)], { type: "application/json" }));
      } catch {}
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          send("tie_app_bridge_view");
          io.disconnect();
        }
      }, { threshold: 0.5 });
      io.observe(el);
    } else {
      send("tie_app_bridge_view");
    }
    el.querySelector("a")?.addEventListener("click", () => send("tie_app_bridge_click"));
  })();
</script>

<style>
  /* Golden source: 80-tiehoy/03-效果图/定稿/TIEHoy_App_Promo_Classic_v4_Articulated.html
     CSS values copied verbatim. Do not translate. */
  /* Spacing token: 24px top/bottom to adjacent blocks */
  .tie-app-promo{
    position:relative;
    margin:24px 0;
    padding:22px 0 20px 25px;
    border-bottom:1px solid #D8D5CF;
  }
  .tie-app-promo::before{
    content:"";
    position:absolute;
    left:0;top:22px;height:48px;
    width:2px;background:#8A3F31;
  }
  .tie-app-promo__brand{
    margin:0 0 20px;
  }
  .tie-app-promo__name-row{
    display:flex;
    align-items:center;
    gap:10px;
  }
  .tie-app-promo__logo{
    flex-shrink:0;
    object-fit:contain;
    opacity:0.85;
  }
  .tie-app-promo__eyebrow{
    display:block;
    margin:0 0 7px;
    font:600 9px/1 -apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Arial,sans-serif;
    letter-spacing:.18em;
    color:#8A8680;
    text-transform:uppercase;
  }
  .tie-app-promo__name{
    margin:0;
    font:400 48px/.88 Georgia,"Times New Roman",serif;
    letter-spacing:-.052em;
    color:#242321;
  }
  .tie-app-promo__name em{
    font-weight:400;font-style:italic;color:#8A3F31;
  }
  .tie-app-promo__promise{
    margin:0;
    padding-left:1px;
    font:400 19px/1.48 Georgia,"Times New Roman",serif;
    letter-spacing:-.012em;
    color:#575451;
  }
  .tie-app-promo__promise span{display:block}
  .tie-app-promo__promise span:nth-child(1){color:#706c67}
  .tie-app-promo__promise span:nth-child(2){color:#4f4b47}
  .tie-app-promo__promise span:nth-child(3){
    margin-top:2px;
    color:#242321;
    font-size:21px;
  }
  .tie-app-promo__action{
    display:inline-grid;
    grid-template-columns:24px auto 20px;
    align-items:center;
    column-gap:9px;
    margin-top:23px;
    min-height:44px;
    color:#8A3F31;
    text-decoration:none;
    font:400 17px/1 Georgia,"Times New Roman",serif;
  }
  .tie-app-promo__apple{width:19px;height:19px;flex-shrink:0;fill:currentColor}
  .tie-app-promo__arrow{
    font:400 20px/1 Georgia,"Times New Roman",serif;
    transition:transform .18s ease;
  }
  .tie-app-promo__action:hover .tie-app-promo__arrow,
  .tie-app-promo__action:focus-visible .tie-app-promo__arrow{transform:translateX(3px)}
  .tie-app-promo__action:focus-visible{outline:2px solid #8A3F31;outline-offset:5px}
</style>
